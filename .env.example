# docker-compose.full.yml 用の設定。 cp .env.example .env して書き換える。
# 書かなかった項目は、同じホストでモデルを配信している場合の既定値になる。

# ---------------------------------------------------------------------
# 1. モデルの接続先（必ず確認する）
#    コンテナから見た URL を書く。同じホストで配信しているなら host.docker.internal、別の機体ならその IP。
# ---------------------------------------------------------------------
# 生成（OpenAI 互換。抽出・チャット・後処理、EDC も同じものを使う）
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_MODEL=google/gemma-4-26B-A4B-it
LLM_API_KEY=dummy

# 埋め込み（OpenAI 互換の /v1/embeddings。ベクトル索引は 768 次元で作る）
EMBED_BASE_URL=http://host.docker.internal:8003/v1
EMBED_MODEL=cl-nagoya/ruri-v3-310m
EMBED_API_KEY=dummy

# リランク（/v1/rerank）。無い環境は CHAT_RERANK_ENABLED=false
RERANK_URL=http://host.docker.internal:8006/v1/rerank
RERANK_MODEL=cl-nagoya/ruri-v3-reranker-310m
# CHAT_RERANK_ENABLED=true

# PDF の構造の読み取り（Nemotron Parse）。届かないときは文字層だけの簡易変換に戻る
PARSE_URL=http://host.docker.internal:8022/v1
PARSE_MODEL=nemotron-parse

# スキャン PDF の OCR（PaddleX、EDC の /convert が使う）。無ければそのままでよい
OCR_URL=http://host.docker.internal:8005

# ---------------------------------------------------------------------
# 2. 画面（ブラウザから見たこのホストの名前か IP。frontend のビルド時に焼き込む）
# ---------------------------------------------------------------------
PUBLIC_HOST=localhost

# ---------------------------------------------------------------------
# 3. Neo4j
# ---------------------------------------------------------------------
NEO4J_PASSWORD=kgb-please-change

# ---------------------------------------------------------------------
# 4. ポートとメモリ（既定のままでよければ触らない）
# ---------------------------------------------------------------------
# FRONTEND_PORT=8441
# BACKEND_PORT=8440
# EDC_PORT=8081
# NEO4J_HTTP_PORT=7475
# NEO4J_BOLT_PORT=7688
# BIND_ADDR=0.0.0.0
# BACKEND_MEM_LIMIT=6g
# NEO4J_MEM_LIMIT=7g
# NEO4J_HEAP_MAX=4G
# NEO4J_PAGECACHE=2G

# ---------------------------------------------------------------------
# 5. 任意
# ---------------------------------------------------------------------
# 文書台帳（PostgreSQL。作り方は tools/kg/registry/setup_db.sh）。空なら使わない
# DOCUMENT_REGISTRY_DSN=postgresql://<利用者>:<パスワード>@host.docker.internal:5432/document_registry
# EDC の同時要求数（生成サーバーの余力に合わせる）
# EDC_CONCURRENCY=4
# 上記以外の backend の設定（backend/example.env にある名前）は backend/.env に書けば効く
