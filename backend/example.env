OPENAI_API_KEY = "" #Mandatory- Default_Value = "openai_api_key"  #This is required if you are using openai embedding model
EMBEDDING_MODEL = "" #OPTIONAL- Default_Value ="all-MiniLM-L6-v2" -- Embedding model to be used for text embedding
EMBEDDING_PROVIDER = "" #OPTIONAL- Default_Value ="sentence-transformer" -- Embedding provider to be used for text embedding
IS_EMBEDDING = "" #OPTIONAL- Default_Value ="True" --Flag to enable text embedding
BUCKET_UPLOAD_FILE = "" #OPTIONAL- Default_Value ="gcs bucket name" -- use the gcs bucket to upload local file to gcs cloud
BUCKET_FAILED_FILE = "" #OPTIONAL- Default_Value ="gcs bucket name" -- use the gcs bucket for failed file while extraction
PROJECT_ID = ""         #OPTIONAL- Default Value ="gcp project id"  -- gcp project id from where the gcs bucket is created
KNN_MIN_SCORE = "" #OPTIONAL- Default_Value ="0.8" --Minimum score for KNN algorithm 
GCP_LOG_METRICS_ENABLED = "" #OPTIONAL- Default_Value = "False" -- Enable to logs metrics on gcp cloud logging
UPDATE_GRAPH_CHUNKS_PROCESSED = "" #OPTIONAL- Default_Value ="20" -- Number of chunks processed to update the graph
NEO4J_URI = "" #OPTIONAL- Default_Value ="Neo4j URL"
NEO4J_USERNAME = "" #OPTIONAL- Default_Value = "Neo4J database username"
NEO4J_PASSWORD = "" #OPTIONAL- Default_Value = "Neo4j database user password"
NEO4J_DATABASE = "" #OPTIONAL- Default_Value = "Neo4j database user database"
GCS_FILE_CACHE = "" #OPTIONAL- Default_Value = "False" #save the file into GCS or local, SHould be True or False
ENABLE_USER_AGENT = "" #OPTIONAL- Default_Value = "False"
USER_AGENT="" #OPTIONAL- Default_Value = "LLM-Graph-Builder"
ENTITY_EMBEDDING="" #OPTIONAL- Default_Value = "False"-- Value based on whether to create embeddings for entities suitable for entity vector mode
DUPLICATE_SCORE_VALUE = "" #OPTIONAL- Default_Value = "0.97" -- Node score value to match duplicate node
DUPLICATE_TEXT_DISTANCE = "" #OPTIONAL- Default_Value = "3" --This value used to find distance for all node pairs in the graph and calculated based on node properties
DEFAULT_DIFFBOT_CHAT_MODEL="" #OPTIONAL- Default_Value = "openai_gpt_5.4_mini"  #whichever model specified here , need to add config for that model in below format)
GRAPH_CLEANUP_MODEL="" #OPTIONAL- Default_Value = "openai_gpt_5.4_mini" -- Model name to clean-up graph in post processing
BEDROCK_EMBEDDING_MODEL_KEY="" #OPTIONAL - Default_Value = "aws_access_key,aws_secret_key,region_name" -- If want to use bedrock embedding
YOUTUBE_TRANSCRIPT_PROXY="" #Mandatory --Proxy key required to process youtube video for getting transcript --Sample Value ="https://user:pass@domain:port"
EFFECTIVE_SEARCH_RATIO="" #OPTIONAL- Default_Value = "5"
MAX_TOKEN_CHUNK_SIZE="" #OPTIONAL- Default_Value = "10000" #Max token used to process/extract the file content.
#examples
LLM_MODEL_CONFIG_OPENAI_GPT_5_5="gpt-5.5,openai-key"
LLM_MODEL_CONFIG_OPENAI_GPT_5_4_MINI="gpt-5.4-mini,openai-key"
LLM_MODEL_CONFIG_GEMINI_3_5_FLASH="gemini-3.5-flash"
LLM_MODEL_CONFIG_DIFFBOT="diffbot,diffbot_api_key"
LLM_MODEL_CONFIG_GROQ_LLAMA3_1_8B="llama-3.1-8b-instant,base_url,groq_api_key"
LLM_MODEL_CONFIG_ANTHROPIC_CLAUDE_4_6_SONNET="claude-sonnet-4-6,anthropic_api_key"
LLM_MODEL_CONFIG_ANTHROPIC_CLAUDE_4_7_OPUS="claude-opus-4-7,anthropic_api_key"
LLM_MODEL_CONFIG_LLAMA4_MAVERICK="Llama-4-Maverick-17B-128E-Instruct-FP8,api_endpoint,api_key"
LLM_MODEL_CONFIG_AZURE_AI_GPT_4O="gpt-4o,https://YOUR-ENDPOINT.openai.azure.com/,azure_api_key,api_version"
# Internal app token `fireworks_qwen3_6` resolves to the Fireworks serverless slug `qwen3p6-plus`.
LLM_MODEL_CONFIG_FIREWORKS_QWEN3_6="accounts/fireworks/models/qwen3p6-plus,fireworks_api_key"
LLM_MODEL_CONFIG_FIREWORKS_GPT_OSS="accounts/fireworks/models/gpt-oss-120b,fireworks_api_key"
LLM_MODEL_CONFIG_FIREWORKS_DEEPSEEK_V3="accounts/fireworks/models/deepseek-v3p1,fireworks_api_key"
LLM_MODEL_CONFIG_FIREWORKS_DEEPSEEK_V4_FLASH="accounts/fireworks/models/deepseek-v4-flash,fireworks_api_key"
LLM_MODEL_CONFIG_FIREWORKS_KIMI_K2P6="accounts/fireworks/models/kimi-k2p6,fireworks_api_key"
LLM_MODEL_CONFIG_FIREWORKS_GLM_5_1="accounts/fireworks/models/glm-5.1,fireworks_api_key"
LLM_MODEL_CONFIG_BEDROCK_NOVA_MICRO_V1="amazon.nova-micro-v1:0,aws_access_key,aws_secret_key,region_name"
LLM_MODEL_CONFIG_BEDROCK_NOVA_LITE_V1="amazon.nova-lite-v1:0,aws_access_key,aws_secret_key,region_name"
LLM_MODEL_CONFIG_BEDROCK_NOVA_PRO_V1="amazon.nova-pro-v1:0,aws_access_key,aws_secret_key,region_name"
LLM_MODEL_CONFIG_OLLAMA_LLAMA3="llama3_model_name,model_local_url"
# EDC (Extract-Define-Canonicalize) API integration - extraction only, format: <base_url>[,<doctype>[,<chunk_method>[,<concurrency>]]]
LLM_MODEL_CONFIG_EDC="http://host.docker.internal:8080,auto,recursive,2"
# EDC_EXTRACTION_TIMEOUT="900" #Optional, per-chunk EDC request timeout in seconds
# EDC_ENRICH_SCHEMA="false" #Optional. false keeps EDC relations inside the doctype vocabulary; dropped ones go to EDC_PROPOSALS_DIR
# EDC_PROPOSALS_DIR="/code/edc_proposals" #Optional, where out-of-vocabulary EDC triples are appended (proposals.jsonl)
# Optional. The LLM that EDC uses (same as VLLM_MODEL in EDC's .env). Recorded as Document.model for EDC extraction
# EDC_LLM_MODEL="google/gemma-4-26B-A4B-it"
# vLLM embedding server (OpenAI-compatible /v1/embeddings), used when EMBEDDING_PROVIDER=vllm. Format: <base_url>[,<api_key>]
VLLM_EMBEDDING_ENDPOINT="http://192.168.0.250:8003/v1,dummy"
# Convert PDFs via EDC /convert (PaddleX OCR, scanned-PDF support). Falls back to the page loader (pypdfium2) on failure
EDC_PDF_CONVERT="true"
# EDC_CONVERT_TIMEOUT="300" #Optional, seconds
# Heading-aware markdown chunking with breadcrumb prefix (applies to .md / heading-bearing text)
MARKDOWN_CHUNKING="true"
# Disable LLM-driven schema consolidation rename when sharing the graph with EDC/graphrag vocabularies
GRAPH_SCHEMA_CONSOLIDATION_ENABLED="false"
TRACK_USER_USAGE="true" #Add this if you want to track token usage
DAILY_TOKENS_LIMIT="250000" #Mandatory if TRACK_USER_USAGE is true
MONTHLY_TOKENS_LIMIT="1000000" #Mandatory if TRACK_USER_USAGE is true
TOKEN_TRACKER_DB_URI=""  #Mandatory if TRACK_USER_USAGE is true
TOKEN_TRACKER_DB_USERNAME="" #Mandatory if TRACK_USER_USAGE is true
TOKEN_TRACKER_DB_PASSWORD="" #Mandatory if TRACK_USER_USAGE is true
TOKEN_TRACKER_DB_DATABASE="" #Mandatory if TRACK_TOKEN_USAGE is true
AUTHENTICATION_REQUIRED="" #OPTIONAL- Default_Value = "False" -- Enable authentication for API access

# PDF chunking strategy. "markdown": convert the PDF to Markdown (PDF_CONVERTER) and split it on headings and paragraph
# boundaries, the same route as .md files. "token" (default): upstream fixed-size token splitting.
# A PDF falls back to the default loader when most of its pages are scans without a text layer, or when it has any such
# page and EDC_PDF_CONVERT is on (so that OCR can read them). Pages without a text layer are always reported in a WARNING.
# PDF_DROP_RUNNING_HEADERS は pymupdf4llm の経路の設定で、2026-11-10 に経路ごと外した（使われない）
# PDF_CHUNK_STRATEGY="markdown"
# PDF を Markdown に変換する方式（PDF_CHUNK_STRATEGY=markdown のときだけ効く）。regions のみ（本文の文字は文字層（pypdfium2）、
# ページの構造は Nemotron Parse、図は既定で図中の文字と題だけ。AGPL の部品を使わない）。
# regions が失敗したとき（None・例外、ページ数が PDF_REGIONS_MAX_PAGES を超えるとき）は、文字層だけの簡易変換
# （ページの印と本文の行、番号の見出し。Nemotron Parse・VLM を呼ばない）に戻す。それも失敗したら EDC の OCR・ページごとの読み込みへ。
# 以前の値 pymupdf4llm（AGPL）は 2026-11-10 に外した。指定されていれば警告して regions として扱う。
# backend からホストのポートへは host.docker.internal で届く
# PDF_CONVERTER="regions"
# PDF_REGIONS_PARSE_URL="http://host.docker.internal:8022/v1"
# PDF_REGIONS_PARSE_MODEL="nemotron-parse"
# PDF_REGIONS_TRIAGE_URL="http://host.docker.internal:8030/v1"
# PDF_REGIONS_TRIAGE_MODEL="google/gemma-4-E4B-it"
# PDF_REGIONS_VLM_URL="http://host.docker.internal:8000/v1"
# PDF_REGIONS_VLM_MODEL="google/gemma-4-26B-A4B-it"
# 図の扱い: text（既定。VLM を呼ばず図中の文字と題だけ）| describe（種類を判定し図・グラフに「（図の説明・自動生成）」の説明を
# 付ける。本番 6 文書では説明 6 個すべてに読み誤りがあった）| off
# PDF_REGIONS_FIGURES="text"
# 1 回の要求の時間切れ（秒）と、接続の失敗・5xx のときの送り直しの回数。応答の時間切れは送り直さない。
# 時間切れ・接続の失敗・5xx が 2 回続いた接続先は 300 秒のあいだ呼ばない
# PDF_REGIONS_TIMEOUT="180"
# PDF_REGIONS_RETRIES="2"
# 同時の要求の上限。同じコンテナの全作業プロセスで共有する（ロック用ファイルの置き場所 PDF_REGIONS_LOCK_DIR、空なら一時フォルダ）。
# この変換器からの要求だけを数える。26B は画像付きの同時 6 本でハングした記録がある
# PDF_REGIONS_PARSE_CONCURRENCY="2"
# PDF_REGIONS_VLM_CONCURRENCY="2"
# PDF_REGIONS_LOCK_DIR=""
# 文書 1 本の時間の上限（秒、0 は無し）。超えたら残りのページは文字層だけで組み立て、図の説明を省く
# PDF_REGIONS_DEADLINE="600"
# 変換するページ数の上限。超える PDF は文字層だけの簡易変換で変換する
# PDF_REGIONS_MAX_PAGES="300"
# 枠の題名の欄を文書の先頭に見出し（## 題名）として置く
# PDF_REGIONS_TITLE="true"
# Prefix every Markdown chunk with [file name > heading path]. Set false when file names carry no meaning (e.g. UUIDs).
# MARKDOWN_BREADCRUMB_TITLE="true"
# MAX_TOKEN_CHUNK_SIZE caps one document (0 or less = no cap on either route). On the Markdown route it is counted in
# actual body tokens; on the token route it is the upstream chunk-count cap (MAX_TOKEN_CHUNK_SIZE / token_chunk_size).
# Anything beyond the cap is NOT ingested (a WARNING is logged).
# Chunk reference links (post_processing task "link_chunk_references"): (:Chunk)-[:REFERS_TO]->(:Chunk) for "see section X" style references
# CHUNK_REFERENCE_MODE="llm" #Optional, how reference links between chunks are made: "llm" (default, LLM only), "hybrid" (patterns first, the LLM only for what patterns cannot resolve), "rule" (patterns only, no LLM calls)
# CHUNK_REFERENCE_DOCUMENT_PLACES="true" #Optional, in hybrid mode let the LLM pick the place inside a document that is cited without a section number
# CHUNK_REFERENCE_RULE_DISABLE="" #Optional, comma separated pattern groups to turn off: heading_name, sub_fallback, alias_table
# CHUNK_REFERENCE_MIN_FAILURES="3" #Optional, in hybrid mode a document is skipped only after this many failed LLM chunks
# CHUNK_REFERENCE_MODEL="gemma4" #Optional, defaults to GRAPH_CLEANUP_MODEL
# CHUNK_REFERENCE_SHORTLIST="8" #Optional, candidate chunks shown to the LLM per reference
# CHUNK_REFERENCE_DOCUMENT_SHORTLIST="12" #Optional, candidate documents shown to the LLM per reference
# CHUNK_REFERENCE_PREFILTER="80" #Optional, candidates kept by character overlap before reranking
# CHUNK_REFERENCE_QUOTE_OVERLAP="0.5" #Optional, share of an extracted quote that must literally appear in the chunk
# CHUNK_REFERENCE_MAX_FAILURE_RATE="0.5" #Optional, a document whose failed chunks exceed this share is left untouched
# CHUNK_REFERENCE_NEIGHBOR_CHARS="2500" #Optional, text around the citing chunk always shown to the LLM (for "the previous article")
# CHUNK_REFERENCE_LISTING_CHARS="9000" #Optional, total size of the candidate listing shown to the LLM
# CHUNK_REFERENCE_NAME_MATCH="0.8" #Optional, how closely a cited name must match a file name to be shortlisted by spelling
# CHUNK_REFERENCE_LLM_TIMEOUT="300" #Optional, seconds per LLM call
# CHUNK_REFERENCE_ABORT_AFTER="5" #Optional, stop the run after this many consecutive LLM failures
# Tokenizer used to measure chunk length on the Markdown route: a tiktoken encoding name (default "gpt2", as upstream),
# or the path of a Hugging Face tokenizer.json. Point it at the embedding model's tokenizer so that token_chunk_size
# means what the embedding and reranker models actually see, in any language.
# CHUNK_TOKENIZER="/code/tokenizers/<model>/tokenizer.json"
# Defaults used when /extract is called without token_chunk_size / chunk_overlap / chunks_to_combine
# DEFAULT_TOKEN_CHUNK_SIZE="512"
# DEFAULT_CHUNK_OVERLAP="50"
# DEFAULT_CHUNKS_TO_COMBINE="1"
# Chat retrieval: follow chunk reference links (REFERS_TO) one hop from the selected chunks and add the best N referenced chunks (0 = off)
# CHAT_REFERENCE_MAX="0"
# How the referenced chunks are selected: target = by the referenced text (as before) / link = by the sentence that makes the reference
# / both = keep the ones selected by the referenced text and add the ones selected by the referring sentence
# CHAT_REFERENCE_SELECT="target"
# Follow a reference only when its sentence scores at least this much against the question (reranker score, 0-1; used by link / both)
# CHAT_REFERENCE_MIN_SCORE="0.3"
# 2 = also follow one reference inside each referenced chunk (used by link / both)
# CHAT_REFERENCE_DEPTH="1"
# Follow references that point to a whole document (no clause / table given) by picking one chunk in it (used by link / both)
# CHAT_REFERENCE_DOCUMENTS="true"
# Weight for references found in revision-history text (1 = same as body text, 0 = never follow)
# CHAT_REFERENCE_HISTORY_WEIGHT="1.0"
# Where a chunk selected by the referring sentence is shown to the LLM: separate = in its own document block (as before)
# / inline = right after the chunk that refers to it, under a heading
# CHAT_REFERENCE_PRESENTATION="separate"
# Add one guideline about cross-references to the answer prompt
# CHAT_REFERENCE_PROMPT="false"
# 文書のみを指す参照（項・別表の指定なし）の中の選び方: rerank = 文書のチャンクをリランクで 1 件（従来）
# / summary_list = 節の要点（後処理 build_section_summaries）の一覧から LLM に最大 CHAT_REFERENCE_DOC_MAX 節を選ばせ、節ごとに 1 件。失敗したら rerank
#   （選んだ節のチャンクが CHAT_REFERENCE_MIN_SCORE 未満なら足さない。2 件目以降は本文が CHAT_CONTEXT_CHAR_BUDGET の 85% に収まる分だけ。2 回目の追跡は 1 件）
# CHAT_REFERENCE_DOC_SELECT="rerank"
# CHAT_REFERENCE_DOC_MAX="4"
# 節の数がこの値を超える文書は、章の要点で章を選んでから節を選ぶ
# CHAT_REFERENCE_DOC_TWO_STAGE_SECTIONS="30"
# 一覧選択に使う LLM（LLM_MODEL_CONFIG_<名前> の OpenAI 互換の接続）と、1 回の要求の時間切れ（秒）。1 つの質問の中で一度失敗したら、残りの参照は rerank
# CHAT_REFERENCE_DOC_SELECT_MODEL="gemma4"
# CHAT_REFERENCE_DOC_SELECT_TIMEOUT="60"
# 節の要点の作成（後処理 build_section_summaries）に使う LLM・同時の要求の数（1 プロセスあたり 3 まで。作成は同じコンテナで同時に 1 本）・1 回の要求の時間切れ（秒）
# SECTION_SUMMARY_MODEL="gemma4"
# SECTION_SUMMARY_CONCURRENCY="3"
# SECTION_SUMMARY_TIMEOUT="120"
# PDF_FRAME_TABLES は pymupdf4llm の経路（frame_pages.py、PyMuPDF）の設定で、2026-11-10 に経路ごと外した（使われない）。
# 枠付きの様式は regions・簡易変換とも pdf_regions/frame.py が読む
# Markdown の分割で、本文がこのトークン数に満たないチャンクは同じ文書の前後のチャンクに統合する（0 の場合は統合しない）
MARKDOWN_MIN_CHUNK_TOKENS=80

# CHUNK_ID_MODE: how a Chunk node id is derived. "document" (default) = sha1(fileName + position + text), so an identical
# section in two documents (shared criteria, boilerplate frames, unchanged sections across versions) stays two nodes.
# "content" = sha1(text) only (the upstream behaviour); kept solely to reproduce old experiment records. Do not use for new graphs.
CHUNK_ID_MODE=document

# 社外へ通信しない（オンプレミスの制約）。いずれも backend の再起動後に反映される（load_dotenv で読み込む）
# ragas（評価 API が使用する）の利用統計を t.explodinggradients.com へ送信しない
RAGAS_DO_NOT_TRACK=true
# onnxruntime（PDF の Markdown 変換で読み込む）の利用統計を Microsoft へ送信しない
ORT_DISABLE_TELEMETRY=1
# tiktoken の gpt2 の符号化ファイルをローカルから読み込む（ない場合は実行時に openaipublic.blob.core.windows.net から取得する）。作成方法は README の「社外へ通信しない設定」
TIKTOKEN_CACHE_DIR=/code/tokenizers/tiktoken-cache
